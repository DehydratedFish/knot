use basic;
use local "dependencies/mountain" as mountain;

executable: knot {
    folder: "build/debug";

    symbols: "DEVELOPER", "BOUNDS_CHECKING";
    include: "source";

    sources: /"source", "knot.cpp", "parser.cpp", "type_check.cpp", "codegen.cpp";

    dependencies: debug, mountain.core, llvm_develop;
}

// This is just working for my system. Bricks needs an update for this to work independently.
brick: llvm_develop {
    include: "D:\lib\llvm\include";

    dependencies(@msvc): "D:\lib\llvm\lib\LLVM-C.lib";
    dependencies(@gcc): "-lLLVM-21";
}

