v0, v1 :: 4, 5;
v2, v3 :: 1, 42 - 1;

Factor :: 2;
var :: 3 + 4 * Factor / v0;

User :: struct {
    name: string;
}

overload :: (): s32 {
    return 42;
}

overload :: (num: s32): s32 {
    return num;
}

List :: struct {
    data:  u8&;
    size:  s64;
    alloc: s64;
}

grow :: (list: List&) {
    new_alloc := list.alloc * Factor;
}

